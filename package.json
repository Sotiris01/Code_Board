{
  "name": "aepp_board",
  "version": "1.0.0",
  "description": "AEPP Board - Collaborative Teaching Board for ΓΛΩΣΣΑ",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "tunnel": "ngrok http 3000",
    "new:lang": "node scripts/new-language.mjs",
    "setup": "node scripts/postinstall.mjs --interactive",
    "doctor": "node scripts/doctor.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:server": "node --test \"tests/server/*.test.js\"",
    "test:client": "node --test \"tests/client/*.test.js\"",
    "lint": "node scripts/lint.mjs"
  },
  "keywords": [
    "education",
    "greek",
    "programming",
    "collaboration"
  ],
  "author": "Σωτήρης Μπαλατσιάς",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "archiver": "^7.0.1",
    "express": "^5.2.1",
    "fast-diff": "^1.3.0",
    "iconv-lite": "^0.7.2",
    "multer": "^2.0.2",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
