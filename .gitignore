# Dependencies
node_modules/

# Environment files
.env
.env.local
.env.*.local

# Session state (legacy location, kept for old clones)
.session-state.json

# Runtime-editable data (settings, session state, ngrok token).
# Keep the folder tracked, ignore its contents except teacher-info.json
# (which still ships sensible defaults until the in-app Settings UI lands in Phase 6).
data/*
!data/.gitkeep
!data/teacher-info.json

# Per-session uploads (auto-created on every server run)
uploads/*
!uploads/.gitkeep

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Editor directories
.idea/
.vscode/
*.swp
*.swo

# Build outputs (if any)
dist/
build/

# Project Documentation & Sources to Ignore
GEMINI.md
prompt.md
*.tex

.gemini/
gha-creds-*.json

# GitHub workflows
.github/
