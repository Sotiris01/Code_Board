      "indentTriggers": ["{"],
      "dedentTriggers": ["}"],
      "autoPairs": { "(": ")", "[": "]", "{": "}", "\"": "\"", "'": "'" }
    },
    {
      "id": "java",
      "label": "Java",
      "namespace": "Java",
      "fileExtensions": [".java"],
      "icon": "java.svg",
      "commentSyntax": { "line": "//", "block": ["/*", "*/"] },
      "indentTriggers": ["{"],
      "dedentTriggers": ["}"],
      "autoPairs": { "(": ")", "[": "]", "{": "}", "\"": "\"", "'": "'" }
    }
  ]
