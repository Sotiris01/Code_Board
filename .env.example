# Code Board — environment variables
#
# Copy to `.env` (gitignored) and adjust. None of these are required;
# every value here is a sensible default mirrored elsewhere in the code.
# Two groups exist:
#
#   1. Runtime knobs read directly by the server on every boot.
#   2. CODE_BOARD_* seed values — read ONCE on first boot (when
#      data/settings.json does not exist) to pre-populate the
#      onboarding wizard's output, so a school IT admin can deploy
#      headlessly without ever opening the dialog.
#
# After the first boot all changes happen through the in-app Settings
# dialog (Phase 6.B). Edit `data/settings.json` directly only as a
# last resort.

# ─────────────────────────────────────────────────────────────────────
# 1. Runtime knobs
# ─────────────────────────────────────────────────────────────────────

# HTTP/WS port the Express + ws server binds to.
PORT=3000

# Optional shared password for the teacher role. When set, anyone hitting
# `/?role=teacher` is challenged for this password before the lobby loads.
# Leave empty for trust-the-LAN deployments.
TEACHER_PASSWORD=

# Days of inactivity before a per-session uploads/<id>/ folder is pruned
# on server boot. 0 disables the auto-cleaner.
UPLOADS_TTL_DAYS=7

# ─────────────────────────────────────────────────────────────────────
# 2. CODE_BOARD_* — first-boot seed values for data/settings.json
# ─────────────────────────────────────────────────────────────────────
# Profile (shown on the lobby card).
CODE_BOARD_PROFILE_NAME=
CODE_BOARD_PROFILE_EMAIL=
CODE_BOARD_PROFILE_PHONE=
CODE_BOARD_PROFILE_DISCORD=

# Classroom.
# Access-code policy: fixed | rotate | free
CODE_BOARD_CLASSROOM_ACCESS_CODE_POLICY=fixed
CODE_BOARD_CLASSROOM_FREE_ENTER_DEFAULT=false
CODE_BOARD_CLASSROOM_AUTO_CLEAR=false
# Seconds to keep a raised hand visible (0 = no timeout).
CODE_BOARD_CLASSROOM_HAND_RAISE_TIMEOUT=0

# Defaults.
# One of the IDs listed in src/languages/registry.json (glossa | python | cpp | java | …).
CODE_BOARD_DEFAULT_LANGUAGE=glossa
# Theme: dark | light | system
CODE_BOARD_DEFAULT_THEME=dark

# Editor.
CODE_BOARD_EDITOR_SOFT_WRAP=false
CODE_BOARD_EDITOR_TAB_SIZE=3
CODE_BOARD_EDITOR_USE_TABS=false
CODE_BOARD_EDITOR_AUTO_PAIRS=true
CODE_BOARD_EDITOR_AUTO_INDENT=true
CODE_BOARD_EDITOR_FONT_SIZE=18
CODE_BOARD_EDITOR_FONT_FAMILY=Consolas, 'Courier New', monospace

# Sharing.
# Mode: local | ngrok
CODE_BOARD_SHARING_MODE=local
# ngrok edge region: us | eu | ap | au | sa | jp | in
CODE_BOARD_SHARING_REGION=eu
CODE_BOARD_SHARING_CUSTOM_DOMAIN=

# Optional ngrok authtoken — when set, written to data/ngrok.json on first boot
# (the file stays gitignored). Add to your dashboard at https://dashboard.ngrok.com.
CODE_BOARD_NGROK_AUTHTOKEN=
CODE_BOARD_NGROK_REGION=eu

# Storage.
CODE_BOARD_STORAGE_UPLOADS_TTL_DAYS=7
